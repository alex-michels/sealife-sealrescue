# Postgres connection string. For a cloud provider (Neon/Supabase) paste the
# full URI they give you. For local Postgres: postgres://user:password@127.0.0.1:5432/dbname
DATABASE_URI=postgres://postgres:password@127.0.0.1:5432/sealife-sealrescue

# SEPARATE database for integration tests (QA-11) — e.g. a Neon branch of the dev DB.
# When set, `npm run test:int` / `test:coverage` use it instead of DATABASE_URI, so tests
# never read or pollute dev data. CI ignores this (ephemeral Postgres per run).
DATABASE_URI_TEST=

# Signs sessions AND the leaderboard anti-cheat play-token (src/endpoints/leaderboard.ts).
# PROD MUST differ from dev — a shared secret would let dev-signed tokens submit to prod.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public base URL of the app (used by Payload for absolute links / cookies).
# Local: http://localhost:3000  |  alpha: https://sealthehunter.online
SERVER_URL=http://localhost:3000

# Privacy-friendly analytics (Plausible, cookieless). Loaded only AFTER opt-in consent.
# Leave EMPTY to disable analytics + the consent banner entirely.
# Cloud: https://plausible.io/js/script.js  |  self-host: https://<your-plausible>/js/script.js
# e2e: tests/e2e/consent.e2e.spec.ts (QA-23) runs only when set — CI uses a dummy
# https://plausible.test/... URL (never resolves; tests intercept it).
NEXT_PUBLIC_PLAUSIBLE_SRC=
